[req]
default_md = sha256
prompt = no
req_extensions = v3_ext
distinguished_name = req_distinguished_name

[req_distinguished_name]
CN = dnode-0.dnode.ml-ns-tls-ednode.svc.cluster.local
OU=MarkLogic

[v3_ext]
keyUsage = critical,digitalSignature,keyEncipherment
extendedKeyUsage = critical,serverAuth,clientAuth
subjectAltName = DNS:localhost,DNS:127.0.0.1,DNS:dnode-0,DNS:dnode-0.dnode,DNS:dnode-0.dnode.ml-ns-tls-ednode,DNS:dnode-0.dnode.ml-ns-tls-ednode.svc,DNS:dnode-0.dnode.ml-ns-tls-ednode.svc.cluster.local,DNS:dnode.ml-ns-tls-ednode.svc.cluster.local
