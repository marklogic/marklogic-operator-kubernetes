[req]
default_md = sha256
prompt = no
req_extensions = v3_ext
distinguished_name = req_distinguished_name

[req_distinguished_name]
CN = marklogic-0.marklogic.marklogic-tlsnamed.svc.cluster.local
OU=MarkLogic

[v3_ext]
keyUsage = critical,digitalSignature,keyEncipherment
extendedKeyUsage = critical,serverAuth,clientAuth
subjectAltName = DNS:localhost,DNS:127.0.0.1,DNS:marklogic-0,DNS:marklogic-0.marklogic,DNS:marklogic-0.marklogic.marklogic-tlsnamed,DNS:marklogic-0.marklogic.marklogic-tlsnamed.svc,DNS:marklogic-0.marklogic.marklogic-tlsnamed.svc.cluster.local,DNS:marklogic.marklogic-tlsnamed.svc.cluster.local